<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true">

    <!-- V3 Header: gradient purple -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_deep_header"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_back_btn"
            android:tint="#FFFFFF"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tv_deep_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧠 深度学习"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp" />

        <ImageView
            android:id="@+id/iv_history"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_menu"
            android:background="@drawable/bg_back_btn"
            android:tint="#FFFFFF"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Message Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/sv_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ll_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <include
            android:id="@+id/ll_summary"
            layout="@layout/layout_learning_summary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#6366F1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 正在准备下一步..."
                android:textColor="#6366F1"
                android:textSize="13sp"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layout_step_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btn_understand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ 听懂了"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:background="@drawable/bg_quick_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_not_understand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤔 没听懂"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:background="@drawable/bg_quick_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👉 继续讲"
                android:textSize="12sp"
                android:textColor="#4F46E5"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_quick_chip_primary"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_summary_ready"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btn_view_summary"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="📊 查看学习总结"
                android:textSize="14sp"
                android:textColor="#6366F1"
                android:gravity="center"
                android:background="@drawable/bg_outline_btn"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/et_input"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="输入你的回答..."
                android:textSize="14sp"
                android:textColor="#1F2937"
                android:background="@null"
                android:gravity="center_vertical"
                android:inputType="textMultiLine"
                android:maxLines="3" />

            <ImageView
                android:id="@+id/iv_send"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_send"
                android:background="@drawable/bg_btn_primary"
                android:tint="#FFFFFF"
                android:padding="9dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
