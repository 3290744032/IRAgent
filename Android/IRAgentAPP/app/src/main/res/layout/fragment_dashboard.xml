<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Dashboard Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_header"
            android:padding="20dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下午好 ☀️"
                android:textSize="13sp"
                android:textColor="#CCFFFFFF" />

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小明同学"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_exam_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 目标：考研 数学 130分"
                android:textSize="12sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Coverage Card (overlaps header) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_white"
            android:padding="20dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-30dp"
            android:elevation="4dp">

            <!-- Coverage ring: outer arc via MPAndroidChart or custom view -->
            <com.suiyuan.iragent_app.ui.screens.profile.CoverageRingView
                android:id="@+id/coverage_ring"
                android:layout_width="80dp"
                android:layout_height="80dp" />

            <LinearLayout
                android:id="@+id/ll_coverage_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:gravity="center_vertical" />
        </LinearLayout>

        <!-- Today Tasks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 今日任务"
                android:textSize="15sp"
                android:textColor="#1F2937"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/ll_today_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Weekly Report -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 学习周报"
                android:textSize="15sp"
                android:textColor="#1F2937"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_week_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/ll_weekly_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Radar Chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 考点掌握度雷达图"
                android:textSize="13sp"
                android:textColor="#374151"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <com.github.mikephil.charting.charts.RadarChart
                android:id="@+id/radar_chart"
                android:layout_width="200dp"
                android:layout_height="200dp" />

            <TextView
                android:id="@+id/tv_radar_labels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="8dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Settings List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="1dp"
            android:paddingTop="8dp">

            <!-- settings-item: 考试目标 -->
            <LinearLayout
                android:id="@+id/ll_settings_exam"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:gravity="center" android:text="🎯" android:textSize="18sp"
                    android:background="@drawable/bg_quick_chip" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="考试目标" android:textSize="14sp"
                    android:textColor="#1F2937" android:layout_marginStart="12dp" />
                <TextView android:id="@+id/tv_settings_exam"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#9CA3AF" />
                <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                    android:text="→" android:textSize="14sp" android:textColor="#D1D5DB"
                    android:gravity="end" android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- settings-item: 知识库管理 -->
            <LinearLayout
                android:id="@+id/ll_settings_knowledge"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:gravity="center" android:text="📚" android:textSize="18sp"
                    android:background="@drawable/bg_quick_chip" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="知识库管理" android:textSize="14sp"
                    android:textColor="#1F2937" android:layout_marginStart="12dp" />
                <TextView android:id="@+id/tv_settings_notes"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#9CA3AF" />
                <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                    android:text="→" android:textSize="14sp" android:textColor="#D1D5DB"
                    android:gravity="end" android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- settings-item: 数据导出 -->
            <LinearLayout
                android:id="@+id/ll_settings_export"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:gravity="center" android:text="📤" android:textSize="18sp"
                    android:background="@drawable/bg_quick_chip" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="数据导出" android:textSize="14sp"
                    android:textColor="#1F2937" android:layout_marginStart="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="错题 + 笔记" android:textSize="12sp" android:textColor="#9CA3AF" />
                <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                    android:text="→" android:textSize="14sp" android:textColor="#D1D5DB"
                    android:gravity="end" android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- settings-item: 重新设置考试目标 -->
            <LinearLayout
                android:id="@+id/ll_settings_reonboard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:gravity="center" android:text="🔄" android:textSize="18sp"
                    android:background="@drawable/bg_quick_chip" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="重新设置考试目标" android:textSize="14sp"
                    android:textColor="#1F2937" android:layout_marginStart="12dp" />
                <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                    android:text="→" android:textSize="14sp" android:textColor="#D1D5DB"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Logout (danger style) -->
            <LinearLayout
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView android:layout_width="36dp" android:layout_height="36dp"
                    android:gravity="center" android:text="🚪" android:textSize="18sp"
                    android:background="@drawable/bg_quick_chip" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="退出登录" android:textSize="14sp"
                    android:textColor="#EF4444" android:layout_marginStart="12dp" />
                <TextView android:layout_width="16dp" android:layout_height="wrap_content"
                    android:text="→" android:textSize="14sp" android:textColor="#D1D5DB"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="80dp" />

    </LinearLayout>
</ScrollView>
