<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/round_bg_white"
        android:backgroundTint="#D1D5DB"
        android:layout_marginBottom="16dp" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨"
            android:textSize="22sp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI 优化笔记"
            android:textSize="17sp"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:text="描述你想要的修改方式，AI 会按照你的要求重新整理这篇笔记。"
        android:textSize="13sp"
        android:textColor="@color/gray_text"
        android:lineSpacingExtra="3dp" />

    <!-- Input field -->
    <android.widget.EditText
        android:id="@+id/et_ai_instruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_rounded"
        android:padding="14dp"
        android:textSize="14sp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_tertiary"
        android:hint="例：整理成表格、提取所有公式、简化语言…"
        android:gravity="start|top"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:maxLines="6"
        android:scrollbars="vertical" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="20dp">

        <Button
            android:id="@+id/btn_ai_cancel"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="取消"
            android:textSize="14sp"
            android:textColor="@color/gray_text"
            android:background="@drawable/bg_btn_outline_gray"
            android:paddingHorizontal="20dp" />

        <Button
            android:id="@+id/btn_ai_start"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="开始优化"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_ai_gradient"
            android:paddingHorizontal="24dp"
            android:layout_marginStart="10dp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
