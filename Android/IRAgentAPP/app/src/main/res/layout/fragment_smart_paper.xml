<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_bg"
    android:fitsSystemWindows="true">

    <!-- ===== Top Header: gradient bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_deep_header"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_back_btn"
            android:tint="#FFFFFF"
            android:padding="8dp"
            android:contentDescription="返回" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_ai"
            android:tint="#FFFFFF"
            android:layout_marginStart="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="智能组卷"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_sparkles"
            android:tint="#55FFFFFF"
            android:padding="4dp" />
    </LinearLayout>

    <!-- ===== Config / Chat phase ===== -->
    <LinearLayout
        android:id="@+id/layout_config"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_stream_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在下方输入你的需求，AI 将自动生成试卷"
            android:textSize="13sp"
            android:textColor="@color/gray_text"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp" />

        <!-- Card: WebView + action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <WebView
                android:id="@+id/wv_stream_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/btn_pdf"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="生成PDF"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btn_start_quiz"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="开始答题"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btn_answer_key"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="查看解析"
                    android:textSize="13sp"
                    android:textColor="@color/primary_color"
                    android:background="@drawable/bg_btn_outline_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Quiz phase ===== -->
    <LinearLayout
        android:id="@+id/layout_quiz"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:layout_margin="16dp"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/10"
                android:textSize="14sp"
                android:textColor="@color/gray_text" />

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/on_surface"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:paddingTop="12dp" />

            <LinearLayout
                android:id="@+id/ll_options"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="16dp" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="下一题"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Loading phase ===== -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/primary_color" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 正在生成..."
            android:textSize="14sp"
            android:textColor="@color/text_tertiary"
            android:paddingTop="16dp" />
    </LinearLayout>

    <!-- ===== Result phase ===== -->
    <LinearLayout
        android:id="@+id/layout_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:layout_margin="16dp"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_result_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/primary_color"
                android:paddingVertical="24dp" />

            <LinearLayout
                android:id="@+id/ll_result_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="答题详情"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:paddingTop="24dp"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:id="@+id/ll_result_details"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_back_hub"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="返回刷题"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Bottom input bar (fixed) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="输入你的需求，如：我想考一张 Android 基础卷子"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/text_tertiary"
                android:background="@null"
                android:gravity="center_vertical"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_send"
                android:background="@drawable/send_btn_bg"
                android:tint="#FFFFFF"
                android:padding="9dp"
                android:contentDescription="发送"
                android:scaleType="centerInside" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
