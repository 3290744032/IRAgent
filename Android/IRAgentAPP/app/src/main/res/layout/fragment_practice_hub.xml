<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hub View -->
        <FrameLayout
            android:id="@+id/layout_hub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Hero banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/ai_message_bg"
                    android:padding="24dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✏️"
                        android:textSize="48sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="刷题练习"
                        android:textSize="18sp"
                        android:textColor="@color/on_surface"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上传试卷自动批改 · AI 智能组卷 · 每日一练"
                        android:textSize="12sp"
                        android:textColor="@color/gray_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 2x2 Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/ai_message_bg"
                        android:padding="20dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="8dp"
                        android:id="@+id/btn_grading"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📸" android:textSize="32sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="上传试卷批改" android:textSize="14sp" android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="拍照上传自动批改" android:textSize="11sp" android:textColor="@color/text_tertiary"
                            android:layout_marginTop="2dp" android:gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_smart_paper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/ai_message_bg"
                        android:padding="20dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🎯" android:textSize="32sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="智能组卷" android:textSize="14sp" android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="AI生成专属试卷" android:textSize="11sp" android:textColor="@color/text_tertiary"
                            android:layout_marginTop="2dp" android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btn_daily_practice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/ai_message_bg"
                        android:padding="20dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📅" android:textSize="32sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="每日一练" android:textSize="14sp" android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="5道题·限时15分钟" android:textSize="11sp" android:textColor="@color/text_tertiary"
                            android:layout_marginTop="2dp" android:gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_exam_archive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/ai_message_bg"
                        android:padding="20dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📚" android:textSize="32sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="真题库" android:textSize="14sp" android:textColor="@color/on_surface"
                            android:fontFamily="sans-serif-medium" android:layout_marginTop="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="历年真题按年份筛选" android:textSize="11sp" android:textColor="@color/text_tertiary"
                            android:layout_marginTop="2dp" android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Grading Flow View -->
        <LinearLayout
            android:id="@+id/layout_grading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/btn_grading_back"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="←"
                    android:gravity="center"
                    android:background="@drawable/btn_quick_reply"
                    android:textColor="@color/gray_text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="试卷批改"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_surface"
                    android:gravity="center" />

                <View android:layout_width="32dp" android:layout_height="32dp" />
            </LinearLayout>

            <!-- Input area -->
            <LinearLayout
                android:id="@+id/layout_grading_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="48dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸"
                    android:textSize="56sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上传试卷照片或文件"
                    android:textSize="15sp"
                    android:textColor="@color/gray_text"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp" />

                <Button
                    android:id="@+id/btn_pick_image"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📷 拍照 / 选择文件"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Progress area -->
            <LinearLayout
                android:id="@+id/layout_grading_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="48dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:indeterminateTint="@color/primary_color" />

                <TextView
                    android:id="@+id/tv_grading_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正在批改..."
                    android:textSize="16sp"
                    android:textColor="@color/gray_text"
                    android:layout_marginTop="20dp" />

                <ProgressBar
                    android:id="@+id/pb_grading"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="16dp"
                    android:progressTint="@color/primary_color" />
            </LinearLayout>

            <!-- Report area -->
            <LinearLayout
                android:id="@+id/layout_grading_report"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tv_report_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="56sp"
                        android:textColor="@color/primary_color"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_report_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="总分"
                        android:textSize="14sp"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_report_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="逐题详情"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_surface"
                    android:layout_marginTop="20dp"
                    android:padding="8dp" />

                <LinearLayout
                    android:id="@+id/ll_report_questions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
