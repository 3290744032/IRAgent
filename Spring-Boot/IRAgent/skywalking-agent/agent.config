# SkyWalking 9.x Agent 配置
# 启动时挂载：-javaagent:skywalking-agent/skywalking-agent.jar -Dskywalking_config=skywalking-agent/agent.config

# 服务名
agent.service_name=IRAgent

# OAP Server gRPC 地址
collector.backend_service=127.0.0.1:11800

# 不记录超过 2000 字符的 SQL 参数
jdbc.sql.parameters.max_length=2000

# === 禁用不需要的插件 ===
# 不使用 Spring Cloud
plugin.spring_cloud.disabled=true
# 不使用 JDBC trace（SQL 日志由 MyBatis-Plus 处理）
plugin.jdbc.connection_info.enabled=false
# 不使用 Spring 注解 trace（手动埋点）
plugin.spring_annotation.enabled=false
# 不需要 CAS 和 Gateway
plugin.cas.disabled=true
plugin.gateway.disabled=true
plugin.feign.disabled=true

# === 采样率 ===
# 生产环境 10%，开发环境 100%
agent.sample_n_per_3_secs=10
